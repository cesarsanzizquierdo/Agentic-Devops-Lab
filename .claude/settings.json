{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(python -m agentes.conformidad.evaluar)",
      "Bash(python labs/S3-contexto/verificar.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Edit(manifiestos/**)",
      "Edit(.github/workflows/**)",
      "Edit(labs/*/verificar.py)",
      "Edit(evals/dorado*/**)",
      "Edit(src/aula/legado/**)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/herramientas/hook_rutas.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/herramientas/hook_tests_commit.py\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/herramientas/hook_formato.py\""
          }
        ]
      }
    ]
  }
}
